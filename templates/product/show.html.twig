{% extends 'base.html.twig' %}

{% block title %}Détails du produit
{% endblock %}

{% block body %}
	<h1>Product</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ product.id }}</td>
			</tr>
			<tr>
				<th>Name</th>
				<td>{{ product.name }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ product.description|raw }}</td>
			</tr>
			<tr>
				<th>Stock</th>
				<td>{{ product.stock }}</td>
			</tr>
			<tr>
				<th>Price</th>
				<td>{{ product.price }} €</td>
			</tr>
			<tr>
				<th>ImageUrl</th>
				<td>{{ product.imageUrl }}</td>
			</tr>

			<tr>
				<a href="{{ path('app_product_index')}}">Retour à la liste</a>
			</tr>
		</tbody>
	</table>


{% endblock %}
